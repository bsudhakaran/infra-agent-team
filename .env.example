# LLM (pick one; unset = deterministic offline mock)
LLM_PROVIDER=ollama            # anthropic | openai | ollama | mock
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
 OLLAMA_BASE_URL=http://localhost:11434

# Guardrails
IAT_BUDGET_USD=5          # monthly forecast above this always needs a human "yes"
IAT_HARD_LIMIT_USD=50     # monthly forecast above this is blocked outright
IAT_TTL_HOURS=4           # default lifetime before `iat sweep` destroys a run
IAT_MAX_ATTEMPTS=3        # coding <-> QA fix-loop attempts

# Locations
# IAT_HOME=.iat                         # run workspaces, Terraform state, QA reports
# IAT_CLOUDS_CONFIG=config/clouds.yaml
